# Copy to .env.development and enter your own local MySQL credentials.
NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://127.0.0.1:5173

# Create this database before running npm run db:migrate.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_profiles
DB_USER=your_mysql_user
DB_PASSWORD="your_mysql_password"
